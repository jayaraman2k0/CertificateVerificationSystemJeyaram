@model CertificateVerificationSystemJeyaram.Models.Certificate

@{
    ViewData["Title"] = "Verification Result";
}

<h2>Verification Result</h2>
<div class="card p-3">
    <h5>@Model.Title</h5>
    <p>Student: @Model.StudentRecord?.FirstName @Model.StudentRecord?.LastName</p>
    <p>Program: @Model.StudentRecord?.Program</p>
    <p>Issued On: @Model.IssuedOn.ToShortDateString()</p>
    <p>Certificate ID: @Model.CertificateId</p>
    <p>Status: @(Model.IsApproved ? "Valid" : "Pending/Not Approved")</p>
    <a class="btn btn-secondary" href="@Model.FilePath">Download</a>
</div>