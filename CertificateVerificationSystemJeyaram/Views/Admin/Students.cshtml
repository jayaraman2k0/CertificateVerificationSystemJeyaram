@model IEnumerable<CertificateVerificationSystemJayaram.Models.StudentRecord>

@{
    ViewData["Title"] = "Students";
}

<h2>Students</h2>
<p>
    <a asp-action="CreateStudent" class="btn btn-primary">Create Student</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Enrollment</th>
            <th>Name</th>
            <th>Email</th>
            <th>Program</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach(var s in Model){
    <tr>
        <td>@s.EnrollmentNumber</td>
        <td>@s.FirstName @s.LastName</td>
        <td>@s.Email</td>
        <td>@s.Program</td>
        <td>
            <a asp-action="UploadCertificate" asp-route-id="@s.Id" class="btn btn-sm btn-secondary">Upload Certificate</a>
        </td>
    </tr>
}
    </tbody>
</table>