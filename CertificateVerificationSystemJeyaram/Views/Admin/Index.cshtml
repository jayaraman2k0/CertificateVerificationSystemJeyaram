@model CertificateVerificationSystemJayaram.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Admin Dashboard</h2>
<div class="row">
    <div class="col-md-4">
        <div class="card p-3">
            <h5>Total Students</h5>
            <h3>@Model.TotalStudents</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h5>Total Certificates</h5>
            <h3>@Model.TotalCertificates</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <h5>Pending Certificates</h5>
            <h3>@Model.PendingCertificates</h3>
        </div>
    </div>
</div>